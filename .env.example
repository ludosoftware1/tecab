TECAB_PORT=8090
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
# Banco de dados PostgreSQL.
# COMPOSE_PROFILES=postgres -> sobe o container do PostgreSQL (serviço "db") junto com o site.
# COMPOSE_PROFILES=         -> não sobe o container; o site usa o PostgreSQL de POSTGRES_HOST/POSTGRES_PORT
#                             (ex.: host.docker.internal para um PostgreSQL no próprio servidor).
COMPOSE_PROFILES=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tecab
POSTGRES_USER=tecab
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Administrador do site (/admin/), criado/atualizado a cada inicialização do container
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_EMAIL=admin@tecab.srv.br
DJANGO_ADMIN_PASSWORD=troque-por-uma-senha-forte
# DJANGO_ALLOWED_HOSTS=tecab.srv.br,www.tecab.srv.br
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tecab.srv.br
# DJANGO_HTTPS=1
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.exemplo.com.br
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# TECAB_CONTATO_DESTINATARIOS=comercial@tecab.srv.br,operacoes@tecab.srv.br
# Destinatários dos formulários.
# Fale Conosco -> TECAB_CONTATO_FALE_DESTINATARIOS
# Trabalhe Conosco -> TECAB_CONTATO_TRABALHE_DESTINATARIOS
# Canal de Integridade -> TECAB_INTEGRIDADE_DESTINATARIOS
# Cada variável aceita uma lista separada por vírgula (vira múltiplos destinatários).
TECAB_CONTATO_FALE_DESTINATARIOS=contato@tecab.srv.br
TECAB_CONTATO_TRABALHE_DESTINATARIOS=vandressa@tecab.srv.br
TECAB_INTEGRIDADE_DESTINATARIOS=lgpd@tecab.srv.br
# DJANGO_HTTPS=1
